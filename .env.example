# Copy this file to .env.local and fill in your own values.
# Placeholders only — never commit real secrets.

# Public site URL used as the canonical / Open Graph base (optional override)
VITE_PUBLIC_SITE_URL=

# Contact configuration (overrides the defaults in src/data/site.js)
VITE_PUBLIC_EMAIL=
VITE_PUBLIC_WHATSAPP=
VITE_PUBLIC_GITHUB_URL=
VITE_PUBLIC_LINKEDIN_URL=

# Optional form endpoint. When empty, the form opens a pre-filled email
# instead. Set to a Formspree / Resend / custom serverless URL when ready.
VITE_PUBLIC_FORM_ENDPOINT=

# Optional analytics Measurement ID (e.g. G-XXXXXXX). Leave empty to disable.
VITE_PUBLIC_ANALYTICS_ID=

# --- Supabase (admin panel / CMS) ---
# Required for the /admin dashboard and database-driven content.
# Create a project at https://supabase.com, then copy the Project URL and
# the public "anon" key from Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NEVER add the service_role key here or anywhere in frontend code.
